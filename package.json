{
  "name": "obs-video-trigger",
  "version": "1.0.1",
  "description": "Plays a video once, fullscreen and unmuted, in an OBS browser source. Triggered from a Stream Deck.",
  "module": "src/main.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/main.ts",
    "build": "bun run scripts/build.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "check": "bun run typecheck && bun test"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
